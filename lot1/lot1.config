; 项目配置文件
ClearDepth = -0.3    ; 清表深度（负值表示向下）
A4WidthMM = 297.0    ; A4图纸宽度（毫米）
A4HeightMM = 210.0   ; A4图纸高度（毫米）
A4Gap = 30.0         ; 图纸边距（毫米）
XyzRows = 35         ; 地形网格行数
XyzCols = 60         ; 地形网格列数
TextScaleFactor = 3.0        ; 文字缩放因子
LineSpacingFactor = 1.5      ; 行距因子
OutputDxf = true     ; 是否输出 DXF 图纸（true=输出 false=不输出）
OutputHtml = true    ; 是否输出 HTML 成果图（true=输出 false=不输出）